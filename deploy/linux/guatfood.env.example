# 复制为 /etc/guatfood/guatfood.env 并修改（chmod 600）
# 注意：值请勿包含空格、单引号、# 等 shell 特殊字符
SPRING_PROFILES_ACTIVE=prod

# 仅监听本机回环，8080 不直接暴露公网（由 Nginx 反代）
SERVER_ADDRESS=127.0.0.1

# 数据库（MySQL 本机）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=guatfood
DB_USERNAME=guatfood
DB_PASSWORD=改成强密码

# JWT 密钥：用 `openssl rand -base64 48` 生成
JWT_SECRET=改成强随机字符串

# 首次初始化管理员密码（仅当数据库为空时使用；生产不会创建演示账号）
INIT_PASSWORD=改成初始管理员强密码

# 开发环境如需演示账号，额外设置 DEMO_PASSWORD；生产环境无需设置
# DEMO_PASSWORD=改成开发演示账号强密码

# 上传目录（确保 guatfood 用户可写）
UPLOAD_PATH=/opt/guatfood/uploads/

# 管理端口：只监听回环，供部署脚本健康检查；不要经 Nginx 暴露
MANAGEMENT_PORT=8081
MANAGEMENT_ADDRESS=127.0.0.1

# 部署脚本/备份脚本使用的备份目录与保留天数
BACKUP_DIR=/var/backups/guatfood
BACKUP_RETENTION_DAYS=14

# 仅信任同机 Nginx 传来的 X-Forwarded-For（多个用逗号分隔）
TRUSTED_PROXIES=127.0.0.1,::1

# JVM 参数（可按内存调整；留空则使用 JVM 默认值）
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
