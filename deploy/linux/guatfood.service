[Unit]
Description=Guat Food Backend (桂航美食推荐排行榜)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=guatfood
Group=guatfood
WorkingDirectory=/opt/guatfood
EnvironmentFile=/etc/guatfood/guatfood.env
Environment=JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/guatfood/current/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=40

# ─── 最小权限加固 ───
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
UMask=0027
# 仅允许写上传目录；应用日志走 journald
ReadWritePaths=/opt/guatfood/uploads
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
